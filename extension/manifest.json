{
  "manifest_version": 3,
  "name": "Norma — Quick Capture",
  "version": "1.0.0",
  "description": "Quickly capture thoughts, notes, and links directly to your Norma instance.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Norma Quick Capture",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ]
}
