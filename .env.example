# PostgreSQL Database connection string
POSTGRES_URL="postgres://default:secret@ep-cool-db.us-east-1.postgres.vercel-storage.com:5432/verceldb"

# Session HMAC signing secret (generate a secure random 32+ char string)
AUTH_SECRET="your-secure-session-signing-secret"

# Vercel Cron trigger secret
CRON_SECRET="your-secure-cron-secret-key"

# Optional global fallbacks (users configure their own keys and emails in Settings)
RESEND_API_KEY="re_optional_global_fallback"
USER_EMAIL="optional_fallback@example.com"
FROM_EMAIL="Norma Digest <onboarding@resend.dev>"
